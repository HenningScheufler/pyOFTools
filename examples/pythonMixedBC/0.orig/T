FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    "inlet|outlet"
    {
        type        pythonMixed;
        file        "system/boundary.py";
        class       HotInflow;
        Tmean       300;
        amplitude   10;
        value       uniform 300;
    }

    sides
    {
        type        empty;
    }
}
