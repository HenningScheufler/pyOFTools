FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

libs            (pyOFToolsBC);

application     scalarTransportFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          0.01;

writeControl    timeStep;
writeInterval   100;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;
